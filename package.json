{
  "name": "hie-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Poole College HIE engagement report: React front end served by Google Apps Script, data kept in NC State Google Sheets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare-deploy": "node scripts/prepare-deploy.mjs",
    "push": "npm run build && npm run prepare-deploy && clasp push",
    "deploy": "npm run push && clasp deploy --description \"$(git rev-parse --short HEAD)\"",
    "check:data": "node scripts/check-no-data.mjs --all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@google/clasp": "^2.5.0",
    "@types/google-apps-script": "^1.0.97",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
